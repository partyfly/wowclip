{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wowclip.local/schemas/wowclip.timeline.v1.schema.json",
  "title": "WowClip Timeline v1",
  "type": "object",
  "required": ["schema", "version", "timebase", "canvas", "assets", "tracks", "durationTicks"],
  "properties": {
    "schema": { "const": "wowclip.timeline.v1" },
    "version": { "type": "integer", "minimum": 0 },
    "timebase": {
      "type": "object",
      "required": ["fps", "ticksPerSecond"],
      "properties": {
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "ticksPerSecond": { "type": "integer", "minimum": 1 }
      }
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "aspectRatio": { "type": "string" }
      }
    },
    "assets": { "type": "object" },
    "tracks": { "type": "array" },
    "durationTicks": { "type": "integer", "minimum": 0 }
  }
}

